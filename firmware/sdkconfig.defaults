# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# LVGL 内置 malloc 池大小。它是独立静态区、不与系统堆共享。
# ★ 必须显式写 CONFIG_LV_MEM_SIZE：lvgl 组件 Kconfig 默认 64KB，会挤占
#   C3 极其紧张的系统堆（播客合并后堆仅 ~15KB，worker 创建全部失败）。
# ★ 32KB 是实测下限：播放器式 UI 开机基线 6.1KB + TODO 四屏 21.2KB +
#   screen-load 分配 ≈ 27.3KB；24KB 池在最后一块屏 load 时耗尽 → 断言死转白屏。
CONFIG_LV_MEM_SIZE=32768

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# main 任务跑应用 enter（建 4 块屏）：3584 会栈穿导致 malloc 死循环/白屏
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# -Os：省 Flash 也省少量 RAM。三合一固件体积敏感（app_cjk_18 字库 470KB rodata）。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- Bluetooth ---
# 重启隔离架构下三合一用不到 BLE（对讲机是原单应用固件的功能）。
# BLE 协议栈常驻要吃掉几十 KB SRAM，C3 无 PSRAM，必须关。
CONFIG_BT_ENABLED=n

# 大号倒计时字体（任务/计时器页）
CONFIG_LV_FONT_MONTSERRAT_48=y

# --- 播客播放器合并（feature/trio）---
# podcast_player 用 xStreamBufferCreateStatic 把 32KB PCM 队列固定在静态区，
# 起播不再向运行时堆要连续大块；静态创建接口需要本选项。
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y
# 流式 PCM 的 TCP 吞吐缓冲（podcast 固件同款实测值）
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# ★ 短连接 TIME_WAIT 快速回收：设备 API 请求全为短连接（收听上报 ~1s 一次），
#   默认 MSL=60s 会把 16 个 TCP PCB 池堆满 → 播放器起播时 tcp_write 报
#   "No more processes"（lwIP 内存耗尽）→ "音频格式错误/服务连接失败"。
CONFIG_LWIP_TCP_MSL=5000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=3000
CONFIG_LWIP_MAX_ACTIVE_TCP=24
# HTTPS 后端走证书包校验；从不绕过证书检查
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# 中文节目名（app_cjk_18 大字形索引；缺字形显示占位方框而非乱码）
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_PLACEHOLDER=y
